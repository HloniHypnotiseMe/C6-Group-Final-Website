# C6GROUP Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required)
# For local development:
VITE_API_URL=http://localhost:3001/api/v1
# For production:
# VITE_API_URL=https://api.c6group.co.za/api/v1

# RemotePay payment API
# Must point to a RemotePay API boundary, never to a provider/acquirer directly.
VITE_REMOTEPAY_API_URL=http://localhost:8000/api/v1
VITE_REMOTEPAY_MERCHANT_ID=
VITE_REMOTEPAY_BRAND_ID=c6-group

# App Configuration
VITE_APP_NAME=C6GROUP
VITE_APP_URL=https://c6group.co.za

# WhatsApp Business Number
VITE_WHATSAPP_NUMBER=27735558440

# Contact Information
VITE_OFFICE_NUMBER=0735558440
VITE_CONTACT_EMAIL=hello@c6group.co.za

# Feature Flags
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_AI_TOOLS=true
VITE_ENABLE_WHATSAPP=true
