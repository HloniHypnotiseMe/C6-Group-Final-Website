# ============================================
# C6GROUP Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend URL (for CORS and payment redirects)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/c6group?schema=public"

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GROQ_API_KEY=gsk-your-groq-api-key
GOOGLE_API_KEY=your-google-api-key

# AWS Configuration (for production)
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Redis (optional, for caching/sessions)
REDIS_URL=redis://localhost:6379

# ============================================
# REMOTEPAY FINTECH SERVICES
# C6 is a RemotePay merchant/brand consumer.
# Provider credentials belong in RemotePay, not C6.
# ============================================
REMOTEPAY_API_URL=https://api.remotepay.co.za/v1
REMOTEPAY_API_KEY=your-remotepay-api-key
REMOTEPAY_MERCHANT_ID=c6-group
REMOTEPAY_BRAND_ID=c6-group

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring
SENTRY_DSN=your-sentry-dsn
