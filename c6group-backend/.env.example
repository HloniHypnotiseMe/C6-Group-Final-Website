# ============================================
# C6GROUP Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/c6group?schema=public"

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GROQ_API_KEY=gsk-your-groq-api-key
GOOGLE_API_KEY=your-google-api-key

# AWS Configuration (for production)
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Redis (optional, for caching/sessions)
REDIS_URL=redis://localhost:6379

# Payment Providers
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Standard Bank SimplyBlu (powered by Mastercard Simplify Commerce)
# Sign up at https://simplyblu.standardbank.co.za
# Generate API keys in the merchant portal and enable "Hosted Payments"
SIMPLYBLU_PUBLIC_KEY=sb_test_your_public_key
SIMPLYBLU_PRIVATE_KEY=sb_test_your_private_key
SIMPLYBLU_API_URL=https://sandbox.simplify.com/v1
SIMPLYBLU_MERCHANT_EMAIL=your-merchant@email.com
# For production, use: https://api.simplify.com/v1

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring
SENTRY_DSN=your-sentry-dsn
