// ============================================
// C6GROUP Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  companyName       String?
  industry          String?
  isEmailVerified   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  role              UserRole  @default(USER)
  status            UserStatus @default(ACTIVE)
  
  // Relations
  subscriptions     Subscription[]
  aiUsages          AIUsage[]
  auditResults      AuditResult[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  
  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

// ============================================
// Subscriptions & Packages
// ============================================

model Subscription {
  id                String              @id @default(uuid())
  userId            String
  packageId         String
  status            SubscriptionStatus  @default(ACTIVE)
  billingCycle      BillingCycle        @default(MONTHLY)
  startDate         DateTime            @default(now())
  endDate           DateTime?
  nextBillingDate   DateTime?
  aiUsageLimit      Int                 @default(0)
  aiUsageUsed       Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          Payment[]
  
  @@index([userId])
  @@index([status])
  @@index([packageId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
  TRIAL
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Payment {
  id              String        @id @default(uuid())
  subscriptionId  String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("ZAR")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  transactionId   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================
// AI Usage Tracking
// ============================================

model AIUsage {
  id          String    @id @default(uuid())
  userId      String
  agentType   String
  prompt      String    @db.Text
  response    String    @db.Text
  tokensUsed  Int
  cost        Decimal   @db.Decimal(10, 6)
  duration    Int       // milliseconds
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([agentType])
  @@index([createdAt])
  @@map("ai_usage")
}

// ============================================
// Audit Results
// ============================================

model AuditResult {
  id                  String    @id @default(uuid())
  userId              String
  companyName         String
  industry            String
  yearsInBusiness     String
  employees           String
  monthlyRevenue      Decimal   @db.Decimal(12, 2)
  websiteUrl          String?
  platforms           String[]
  marketingActivities String[]
  leadGeneration      String
  monthlyLeads        String
  conversionRate      String
  cac                 Decimal?  @db.Decimal(10, 2)
  challenges          String[]
  paymentSystems      String[]
  businessTools       String[]
  techChallenge       String
  
  // Results
  overallScore        Int
  seoScore            Int
  potentialRevenue    Decimal   @db.Decimal(12, 2)
  revenueGap          Decimal   @db.Decimal(12, 2)
  recommendedPackage  String
  recommendations     Json
  actionPlan          Json
  
  createdAt           DateTime  @default(now())
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("audit_results")
}

// ============================================
// Analytics & Metrics
// ============================================

model DailyMetric {
  id              String    @id @default(uuid())
  date            DateTime  @unique
  totalUsers      Int       @default(0)
  newUsers        Int       @default(0)
  activeUsers     Int       @default(0)
  totalRevenue    Decimal   @default(0) @db.Decimal(12, 2)
  newSubscriptions Int      @default(0)
  cancelledSubscriptions Int @default(0)
  totalAiCalls    Int       @default(0)
  totalAiCost     Decimal   @default(0) @db.Decimal(10, 6)
  createdAt       DateTime  @default(now())
  
  @@index([date])
  @@map("daily_metrics")
}

// ============================================
// Webhook Events
// ============================================

model WebhookEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  
  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_events")
}

// ============================================
// System Configuration
// ============================================

model SystemConfig {
  id          String    @id @default(uuid())
  key         String    @unique
  value       Json
  description String?
  updatedAt   DateTime  @updatedAt
  
  @@map("system_config")
}

// ============================================
// AI Tools Catalog
// ============================================

model AITool {
  id            String    @id @default(uuid())
  name          String
  description   String    @db.Text
  category      String
  icon          String?   // Emoji or icon identifier
  tags          String[]
  popular       Boolean   @default(false)
  featured      Boolean   @default(false)
  new           Boolean   @default(false)
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  config        Json?     // Tool-specific configuration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([category])
  @@index([popular])
  @@index([featured])
  @@map("ai_tools")
}

// ============================================
// WhatsApp Conversations
// ============================================

model Conversation {
  id            String    @id @default(uuid())
  phoneNumber   String
  direction     String    // 'inbound' or 'outbound'
  message       String    @db.Text
  type          String    @default("text") // text, template, media
  status        String    @default("received") // received, sent, delivered, read, failed
  metadata      String?   @db.Text // JSON string for extra data
  createdAt     DateTime  @default(now())
  
  @@index([phoneNumber])
  @@index([direction])
  @@index([createdAt])
  @@map("conversations")
}
