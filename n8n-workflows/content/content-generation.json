{
  "name": "C6 Content Generation",
  "nodes": [
    {"parameters":{"httpMethod":"POST","path":"generate-content","responseMode":"lastNode"},"id":"webhook","name":"Content Request","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[250,300]},
    {"parameters":{"operation":"executeQuery","query":"SELECT used_count, monthly_limit FROM content_usage WHERE business_id = '{{$json.body.business_id}}' AND month = '{{ new Date().toISOString().slice(0,7) }}'" },"id":"check","name":"Check Quota","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[450,300]},
    {"parameters":{"conditions":{"number":[{"value1":"={{ $json.used_count }}","operation":"smaller","value2":"={{ $json.monthly_limit }}"}]}},"id":"ifq","name":"Quota OK?","type":"n8n-nodes-base.if","typeVersion":1,"position":[650,300]},
    {"parameters":{"method":"POST","url":"http://orchestrator:7000/run","sendBody":true,"bodyParameters":{"parameters":{"agent":"content_writer","input":"={{ $json.body.topic }}","context":"Type: {{ $json.body.content_type }} | Tone: {{ $json.body.tone }} | Length: {{ $json.body.length }}"}}},"id":"orch","name":"Call Orchestrator","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[850,200]},
    {"parameters":{"operation":"executeQuery","query":"INSERT INTO content_generations (business_id, content_type, topic, content, created_at) VALUES ('{{$("Content Request").item.json.body.business_id}}', '{{$("Content Request").item.json.body.content_type}}', '{{$("Content Request").item.json.body.topic}}', '{{ $json.response }}', NOW())" },"id":"store","name":"Store Content","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[1050,200]},
    {"parameters":{"operation":"executeQuery","query":"UPDATE content_usage SET used_count = used_count + 1 WHERE business_id = '{{$("Content Request").item.json.body.business_id}}' AND month = '{{ new Date().toISOString().slice(0,7) }}'" },"id":"inc","name":"Increment","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[1250,200]},
    {"parameters":{"respondWith":"json","responseBody":"={\"status\":\"success\",\"content\":\"{{ $("Call Orchestrator").item.json.response }}\"}"},"id":"res","name":"Respond","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1450,300]}
  ],
  "connections":{
    "Content Request":{"main":[[{"node":"Check Quota","type":"main","index":0}]]},
    "Check Quota":{"main":[[{"node":"Quota OK?","type":"main","index":0}]]},
    "Quota OK?":{"main":[[{"node":"Call Orchestrator","type":"main","index":0}]]},
    "Call Orchestrator":{"main":[[{"node":"Store Content","type":"main","index":0}]]},
    "Store Content":{"main":[[{"node":"Increment","type":"main","index":0}]]},
    "Increment":{"main":[[{"node":"Respond","type":"main","index":0}]]}
  }
