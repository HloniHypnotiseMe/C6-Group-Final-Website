    {"parameters":{"operation":"executeQuery","query":"SELECT COUNT(*) AS total_content FROM content_generations WHERE created_at > NOW() - INTERVAL '7 days'" },"id":"content","name":"Get Content","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[450,400]},
    {"parameters":{"method":"POST","url":"http://orchestrator:7000/run","sendBody":true,"bodyParameters":{"parameters":{"agent":"business_audit","input":"Write a weekly executive summary based on: {{ $json }}","context":"Weekly metrics for C6 Group"}}},"id":"orch","name":"Generate Report","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[650,300]},
    {"parameters":{"fromEmail":"reports@c6group.co.za","toEmail":"{{$env.ADMIN_EMAIL}}","subject":"C6 Weekly Report","text":"{{ $json.response }}"},"id":"email","name":"Email Report","type":"n8n-nodes-base.emailSend","typeVersion":2,"position":[850,300]}
