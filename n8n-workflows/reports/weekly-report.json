{
  "name": "C6 Weekly Report",
  "nodes": [
    {"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * 1"}]}},"id":"schedule","name":"Every Monday 9am","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},
