    {"parameters":{"conditions":{"number":[{"value1":"={{ $json.used_count }}","operation":"smaller","value2":"={{ $json.monthly_limit }}"}]}},"id":"ifq","name":"Quota OK?","type":"n8n-nodes-base.if","typeVersion":1,"position":[650,300]},
    {"parameters":{"method":"POST","url":"http://orchestrator:7000/run","sendBody":true,"bodyParameters":{"parameters":{"agent":"voice_receptionist","input":"={{ $json.body.caller_speech }}","context":"Business: {{ $json.body.business_name }}"}}},"id":"orch","name":"Call Orchestrator","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[850,200]},
    {"parameters":{"operation":"executeQuery","query":"INSERT INTO voice_calls (business_id, call_sid, caller_number, caller_speech, ai_response, created_at) VALUES ('{{$("Incoming Call").item.json.body.business_id}}', '{{$("Incoming Call").item.json.body.call_sid}}', '{{$("Incoming Call").item.json.body.from}}', '{{$("Incoming Call").item.json.body.caller_speech}}', '{{ $json.response }}', NOW())" },"id":"store","name":"Store Call","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[1050,200]},
    {"parameters":{"operation":"executeQuery","query":"UPDATE voice_usage SET used_count = used_count + 1 WHERE business_id = '{{$("Incoming Call").item.json.body.business_id}}' AND month = '{{ new Date().toISOString().slice(0,7) }}'" },"id":"inc","name":"Increment","type":"n8n-nodes-base.postgres","typeVersion":2,"position":[1250,200]},
    {"parameters":{"respondWith":"json","responseBody":"={\"status\":\"ok\",\"response_text\":\"{{ $("Call Orchestrator").item.json.response }}\"}"},"id":"res","name":"Respond","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[1450,300]}
